# TerraVision AI backend configuration. Copy to ".env" and adjust; every value is optional.
# All variables use the TV_ prefix (see backend/app/config.py).

# --- inference
TV_DEVICE=auto                 # auto | cuda | cpu   (auto falls back to CPU when no GPU is present)
TV_AMP=true                    # mixed precision on CUDA
TV_INFERENCE_BATCH_SIZE=8
TV_TILE_OVERLAP=64
TV_DEFAULT_MODEL=swin_siamese  # swin_siamese | fc_siam_diff
TV_DEFAULT_THRESHOLD=0.5

# --- uploads
TV_MAX_UPLOAD_MB=50
TV_MIN_IMAGE_SIDE=32
TV_MAX_IMAGE_SIDE=4096

# --- paths (relative to the repository root)
TV_STORAGE_DIR=storage
TV_CHECKPOINT_DIR=checkpoints
TV_REPORTS_DIR=reports/evaluation
TV_SAMPLES_DIR=samples
# TV_DATABASE_URL=sqlite:///C:/path/to/terravision.sqlite3

# --- web
TV_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TV_LOG_LEVEL=INFO

# --- satellite acquisition (optional, online)
TV_SATELLITE_MAX_AOI_KM=25
# Copernicus Data Space Ecosystem OAuth client (https://dataspace.copernicus.eu -> User settings -> OAuth clients).
# Leave empty to use the credential-free Earth Search provider only.
TV_CDSE_CLIENT_ID=
TV_CDSE_CLIENT_SECRET=
